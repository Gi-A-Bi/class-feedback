rules_version = '2';

// 발표 평가 프로그램 보안 규칙
//
// 지금은 2단계(교사 로그인, 학급·명단)까지만 다룬다.
// activities / evaluations / results 는 3~4단계에서 더한다.
// 여기에 적히지 않은 경로는 Firestore 기본값대로 아무도 읽고 쓰지 못한다.
//
// 교사  = 구글 로그인 사용자
// 학생  = 익명 인증 사용자
//
// 학생이 "자기가 입장한 학급"인지는 서버가 알 수 없다. 학생 익명 계정에는
// 학급이 묶여 있지 않기 때문이다. 그래서 학급 문서는 "로그인했고 학급 id를
// 아는 사람"이 읽을 수 있게 한다. 학급 id는 Firestore가 만드는 20자리
// 임의 문자열이라 찍어서 맞힐 수 없고, 학생은 입장 코드로만 그 id를 얻는다.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // 교사는 구글 로그인. 익명 사용자는 교사가 아니다.
    function isTeacher() {
      return isSignedIn() && !isAnonymous();
    }

    function isMe(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isText(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    function classOwner(classId) {
      return get(/databases/$(database)/documents/classes/$(classId)).data.teacherId;
    }

    // ── 교사 ───────────────────────────────────────────────
    match /teachers/{uid} {
      allow get: if isMe(uid);
      allow list: if false;

      allow create: if isTeacher() && isMe(uid)
        && request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && isText(request.resource.data.name, 50)
        && request.resource.data.createdAt == request.time;

      allow update: if isTeacher() && isMe(uid)
        && request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && isText(request.resource.data.name, 50)
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    // ── 학급 ───────────────────────────────────────────────
    match /classes/{classId} {
      // 학생은 입장한 학급 하나를 id로 읽는다.
      allow get: if isSignedIn();

      // 목록은 교사가 자기 학급만. where('teacherId','==',uid) 가 없으면 거부된다.
      allow list: if isTeacher() && isMe(resource.data.teacherId);

      allow create: if isTeacher()
        && request.resource.data.keys().hasOnly(['teacherId', 'name', 'joinCode', 'createdAt'])
        && isMe(request.resource.data.teacherId)
        && isText(request.resource.data.name, 30)
        && request.resource.data.joinCode is string
        && request.resource.data.joinCode.size() == 6
        && request.resource.data.createdAt == request.time;

      // 이름만 고칠 수 있다. 주인과 입장 코드와 만든 시각은 그대로여야 한다.
      allow update: if isTeacher() && isMe(resource.data.teacherId)
        && request.resource.data.keys().hasOnly(['teacherId', 'name', 'joinCode', 'createdAt'])
        && isText(request.resource.data.name, 30)
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.joinCode == resource.data.joinCode
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isTeacher() && isMe(resource.data.teacherId);
    }

    // ── 명단 ───────────────────────────────────────────────
    match /classes/{classId}/students/{studentId} {
      // 학생은 자기 이름을 고르려면 명단을 봐야 한다.
      allow read: if isSignedIn();

      allow write: if isTeacher() && isMe(classOwner(classId))
        && (request.method == 'delete' || (
          request.resource.data.keys().hasOnly(['number', 'name'])
          && request.resource.data.number is int
          && request.resource.data.number >= 1
          && request.resource.data.number <= 100
          && isText(request.resource.data.name, 20)
        ));
    }

    // ── 입장 코드 ──────────────────────────────────────────
    // 학생이 코드를 넣으면 이 문서 하나만 읽어 학급 id를 얻는다.
    match /joinCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;  // 코드 목록을 훑어 가지 못하게 한다

      allow create: if isTeacher()
        && request.resource.data.keys().hasOnly(['classId', 'teacherId'])
        && isMe(request.resource.data.teacherId)
        && request.resource.data.classId is string;

      allow update: if false;  // 코드는 고치지 않는다. 지우고 다시 만든다.
      allow delete: if isTeacher() && isMe(resource.data.teacherId);
    }
  }
}
