rules_version = '2';

// 발표 평가 프로그램 보안 규칙
//
// 지금은 3단계(활동, 발표, 평가)까지 다룬다.
// results 는 4단계에서 더한다.
// 여기에 적히지 않은 경로는 Firestore 기본값대로 아무도 읽고 쓰지 못한다.
//
// 교사  = 구글 로그인 사용자
// 학생  = 익명 인증 사용자
//
// 학생이 "자기가 입장한 학급"인지는 서버가 알 수 없다. 학생 익명 계정에는
// 학급이 묶여 있지 않기 때문이다. 그래서 학급 문서는 "로그인했고 학급 id를
// 아는 사람"이 읽을 수 있게 한다. 학급 id는 Firestore가 만드는 20자리
// 임의 문자열이라 찍어서 맞힐 수 없고, 학생은 입장 코드로만 그 id를 얻는다.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // 교사는 구글 로그인. 익명 사용자는 교사가 아니다.
    function isTeacher() {
      return isSignedIn() && !isAnonymous();
    }

    function isMe(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isText(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    function classOwner(classId) {
      return get(/databases/$(database)/documents/classes/$(classId)).data.teacherId;
    }

    // ── 교사 ───────────────────────────────────────────────
    match /teachers/{uid} {
      allow get: if isMe(uid);
      allow list: if false;

      allow create: if isTeacher() && isMe(uid)
        && request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && isText(request.resource.data.name, 50)
        && request.resource.data.createdAt == request.time;

      allow update: if isTeacher() && isMe(uid)
        && request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && isText(request.resource.data.name, 50)
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    // ── 학급 ───────────────────────────────────────────────
    match /classes/{classId} {
      // 학생은 입장한 학급 하나를 id로 읽는다.
      allow get: if isSignedIn();

      // 목록은 교사가 자기 학급만. where('teacherId','==',uid) 가 없으면 거부된다.
      allow list: if isTeacher() && isMe(resource.data.teacherId);

      allow create: if isTeacher()
        && request.resource.data.keys().hasOnly(['teacherId', 'name', 'joinCode', 'currentActivityId', 'createdAt'])
        && isMe(request.resource.data.teacherId)
        && isText(request.resource.data.name, 30)
        && request.resource.data.joinCode is string
        && request.resource.data.joinCode.size() == 6
        && request.resource.data.createdAt == request.time;

      // 이름과 "지금 진행 중인 활동"만 고칠 수 있다.
      // 주인과 입장 코드와 만든 시각은 그대로여야 한다.
      allow update: if isTeacher() && isMe(resource.data.teacherId)
        && request.resource.data.keys().hasOnly(['teacherId', 'name', 'joinCode', 'currentActivityId', 'createdAt'])
        && isText(request.resource.data.name, 30)
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.joinCode == resource.data.joinCode
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isTeacher() && isMe(resource.data.teacherId);
    }

    // ── 명단 ───────────────────────────────────────────────
    match /classes/{classId}/students/{studentId} {
      // 학생은 자기 이름을 고르려면 명단을 봐야 한다.
      allow read: if isSignedIn();

      // 교사: 명단을 통째로 넣고 지운다.
      allow create, delete: if isTeacher() && isMe(classOwner(classId))
        && (request.method == 'delete' || validStudent(request.resource.data));

      // 교사는 아무 칸이나 고칠 수 있다(이름 고치기, 다른 기기에서 고른 것 풀어 주기).
      // 학생은 "이 이름은 내가 쓴다"는 표시만 할 수 있고, 번호와 이름은 못 건드린다.
      allow update: if
        (isTeacher() && isMe(classOwner(classId)) && validStudent(request.resource.data))
        || (isSignedIn() && claimsOnly() && claimAllowed());
    }

    function validStudent(data) {
      return data.keys().hasOnly(['number', 'name', 'claimedBy', 'claimedAt'])
        && data.number is int
        && data.number >= 1
        && data.number <= 100
        && isText(data.name, 20);
    }

    // 학생이 바꾸려는 것이 "고름 표시" 두 칸뿐인가
    function claimsOnly() {
      return request.resource.data.diff(resource.data)
        .affectedKeys().hasOnly(['claimedBy', 'claimedAt']);
    }

    // 아직 아무도 안 골랐거나 원래 내가 고른 이름만 고를 수 있다.
    // 내 표시를 스스로 지우는 것(나가기)도 된다.
    function claimAllowed() {
      let before = resource.data;
      let after = request.resource.data;
      let free = !('claimedBy' in before) || before.claimedBy == null || before.claimedBy == request.auth.uid;
      let takingItMyself = after.claimedBy == request.auth.uid && after.claimedAt == request.time;
      let lettingItGo = after.claimedBy == null && before.claimedBy == request.auth.uid;
      return free && (takingItMyself || lettingItGo);
    }

    // ── 입장 코드 ──────────────────────────────────────────
    // 학생이 코드를 넣으면 이 문서 하나만 읽어 학급 id를 얻는다.
    match /joinCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;  // 코드 목록을 훑어 가지 못하게 한다

      allow create: if isTeacher()
        && request.resource.data.keys().hasOnly(['classId', 'teacherId'])
        && isMe(request.resource.data.teacherId)
        && request.resource.data.classId is string;

      allow update: if false;  // 코드는 고치지 않는다. 지우고 다시 만든다.
      allow delete: if isTeacher() && isMe(resource.data.teacherId);
    }

    // ── 활동 ───────────────────────────────────────────────
    match /activities/{activityId} {
      // 학생은 학급 문서의 currentActivityId 로 활동 id를 알아내 하나만 읽는다.
      allow get: if isSignedIn();
      allow list: if isTeacher() && isMe(resource.data.teacherId);

      allow create: if isTeacher()
        && request.resource.data.keys().hasOnly([
             'classId', 'teacherId', 'title', 'kind', 'criteria',
             'currentPresentationId', 'status', 'resultsPublished', 'createdAt'])
        && isMe(request.resource.data.teacherId)
        && isText(request.resource.data.title, 50)
        && request.resource.data.kind in ['individual', 'group']
        && request.resource.data.status in ['ready', 'running', 'ended']
        && request.resource.data.resultsPublished == false
        && validCriteria(request.resource.data.criteria)
        && request.resource.data.createdAt == request.time;

      allow update: if isTeacher() && isMe(resource.data.teacherId)
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.createdAt == resource.data.createdAt
        && isText(request.resource.data.title, 50)
        && request.resource.data.status in ['ready', 'running', 'ended']
        && validCriteria(request.resource.data.criteria);

      allow delete: if isTeacher() && isMe(resource.data.teacherId);
    }

    function validCriteria(list) {
      return list is list && list.size() >= 1 && list.size() <= 8;
    }

    function activityOwner(activityId) {
      return get(/databases/$(database)/documents/activities/$(activityId)).data.teacherId;
    }

    function activityData(activityId) {
      return get(/databases/$(database)/documents/activities/$(activityId)).data;
    }

    // ── 발표 순서 ──────────────────────────────────────────
    match /activities/{activityId}/presentations/{presentationId} {
      // 학생은 지금 발표와 다음 발표를 봐야 한다.
      allow read: if isSignedIn();
      allow write: if isTeacher() && isMe(activityOwner(activityId));
    }

    // ── 평가 ───────────────────────────────────────────────
    // 문서 id 는 "{발표id}__{학생id}" 로 정해져 있어서, 한 학생이 한 발표에
    // 하나만 쓸 수 있다. 다른 학생의 평가는 읽지 못한다.
    match /activities/{activityId}/evaluations/{evalId} {
      // 교사는 자기 활동의 평가를 모두 읽는다(코멘트 검토용).
      // 학생은 자기가 쓴 것만 읽는다.
      // 학생은 "그 학생 이름을 고른 기기"일 때만 자기 평가를 읽는다.
      // (문서 id만 보면 누구나 읽을 수 있게 되므로 반드시 주인을 확인한다.)
      allow get: if (isTeacher() && isMe(activityOwner(activityId)))
        || (isSignedIn() && isMyStudentDoc(activityId, resource.data.studentId));
      allow list: if isTeacher() && isMe(activityOwner(activityId));

      // 학생이 쓰고 고친다. 교사는 코멘트 숨기기(4단계)에서만 손댄다.
      allow create: if isSignedIn()
        && validEvaluation(activityId, request.resource.data)
        && evalId == expectedEvalId(request.resource.data)
        && isMyStudentDoc(activityId, request.resource.data.studentId)
        && request.resource.data.hidden == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // 교사가 다음 발표자로 넘기기 전까지만 고칠 수 있다.
      allow update: if isSignedIn()
        && validEvaluation(activityId, request.resource.data)
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.presentationId == resource.data.presentationId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.hidden == resource.data.hidden
        && isMyStudentDoc(activityId, resource.data.studentId);

      allow delete: if isTeacher() && isMe(activityOwner(activityId));
    }

    function expectedEvalId(data) {
      return data.presentationId + '__' + data.studentId;
    }

    // 이 평가를 쓰는 사람이, 그 학생 이름을 고른 그 기기인가
    function isMyStudentDoc(activityId, studentId) {
      let classId = activityData(activityId).classId;
      let student = get(/databases/$(database)/documents/classes/$(classId)/students/$(studentId)).data;
      return student.claimedBy == request.auth.uid;
    }

    function validEvaluation(activityId, data) {
      let activity = activityData(activityId);
      return data.keys().hasOnly([
               'presentationId', 'studentId', 'kind', 'scores',
               'comment1', 'comment2', 'hidden', 'createdAt', 'updatedAt'])
        && data.kind in ['peer', 'self']
        && data.presentationId is string
        && data.studentId is string
        // 지금 평가받는 발표에만 쓸 수 있다
        && data.presentationId == activity.currentPresentationId
        && activity.status == 'running'
        // 점수는 1~5 정수, 기준 수만큼만
        && data.scores is map
        && data.scores.values().hasOnly([1, 2, 3, 4, 5])
        && data.scores.keys().size() == activity.criteria.size()
        // 코멘트는 200자까지, 비워 둘 수 있다
        && data.comment1 is string && data.comment1.size() <= 200
        && data.comment2 is string && data.comment2.size() <= 200;
    }
  }
}
